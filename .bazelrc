# Platform-specific configs (build:linux / build:macos) apply automatically.
common --enable_platform_specific_config

# Retry transient module-archive download failures (an entire CI matrix
# died to a GitHub blip on PR #88). Scope note: this flag only retries
# truncated or reset transfers (content-length mismatch, socket reset, DNS);
# a server answering a clean HTTP 5xx is retried solely by Bazel's built-in
# ~25-second exponential backoff, so a sustained GitHub outage still fails
# the fetch — rerun the job.
common --experimental_repository_downloader_retries=5

# C++20 everywhere (ADR-0003 baseline; see docs/PLAN.md §2).
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20

test --test_output=errors

# Hermetic LLVM toolchain with libc++ (dev-only; see MODULE.bazel): the linux
# clang+libc++ matrix cell. libc++-only divergences — vector<bool>'s proxy
# std::hash (#84), C++20-removed traits like std::result_of — otherwise
# surface only on the macOS runners or in consumers' hermetic-LLVM builds.
# The toolchains stay unregistered in MODULE.bazel and are selected here, so
# an ordinary build keeps the autodetected host toolchain.
build:llvm --extra_toolchains=@llvm//toolchain:all
# boost.context's BCR BUILD opts itself into parse_headers, and this toolchain
# registers the tool for it — so its headers compile standalone, where the
# pre-C++17 std::result_of polyfill meets C++20 libc++ (which removed the
# trait) and fails hard. Its own actions compile as C++17 (this trailing
# per-file flag outranks both the toolchain's own default -std=c++17 and the
# global -std=c++20 that overrides it); every first-party TU stays C++20, and
# the other legs never parse external headers (libstdc++ keeps the trait;
# Apple's toolchain has no parse_headers tool).
build:llvm --per_file_copt=external/boost.context@-std=c++17

# AddressSanitizer: bazel test //... --config=asan
build:asan --strip=never
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-g
build:asan --linkopt=-fsanitize=address

# UndefinedBehaviorSanitizer: bazel test //... --config=ubsan
# Assumes clang (CC=clang CXX=clang++): Bazel links through the C driver, which
# omits the UBSan C++ runtime (vptr checks) unless asked for it explicitly.
build:ubsan --strip=never
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --copt=-g
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --linkopt=-fno-sanitize-recover=all
build:ubsan --linkopt=-fsanitize-link-c++-runtime

# ThreadSanitizer (incompatible with asan — separate invocation):
# CC=clang bazel test //runtime:session_registry_test --config=tsan
build:tsan --strip=never
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --copt=-g
build:tsan --linkopt=-fsanitize=thread

# libFuzzer: CC=clang bazel build --config=fuzz //fuzz:json_decode_fuzz
build:fuzz --copt=-fsanitize=fuzzer,address
build:fuzz --linkopt=-fsanitize=fuzzer,address
build:fuzz --strip=never
build:fuzz --copt=-g

# Warnings are errors for first-party code (issue #65). The ^// label filter
# scopes -Werror to this repo's own targets: external deps (boost, boringssl,
# zlib, googletest, ...) keep their toolchain-default warning posture, while
# everything with a //-label — hand-written code, the checked-in generated
# modules, and code SmithyCppGenerate emits into bazel-out — must compile
# clean at the -Wall -Wextra the targets' copts request (bazel/copts.bzl).
# A config rather than a hard-coded copt so a new compiler version's new
# warnings surface as a red CI leg here, never as a broken build for
# consumers compiling from source.
build:werror --per_file_copt=^//@-Werror
# External repos' headers compile as system headers (-isystem), so a
# diagnostic INSIDE a googletest/boost header cannot fail the first-party
# TU that includes it (Apple clang's -Wcharacter-conversion in
# gtest-printers.h was the concrete casualty). Scoped to this config so
# ordinary builds keep full diagnostics.
build:werror --features=external_include_paths

# CI settings.
build:ci --announce_rc --verbose_failures
build:ci --config=werror

# Personal overrides stay out of version control.
try-import %workspace%/.bazelrc.user

# The code generator is Java 17 (matching the Gradle toolchain); rules_java
# compiles and runs it on a hermetic remote JDK.
common --java_language_version=17
common --tool_java_language_version=17
common --java_runtime_version=remotejdk_17
common --tool_java_runtime_version=remotejdk_17

# ADR-0003 enforcement: the dependency-light runtime must build without
# exceptions (many large consumers use -fno-exceptions). Boost.Asio/Beast
# are not -fno-exceptions-clean, so //runtime:http_beast and its dependents
# are excluded from this leg; the core runtime is not.
build:noexcept --copt=-fno-exceptions
build:noexcept --copt=-fno-unwind-tables
