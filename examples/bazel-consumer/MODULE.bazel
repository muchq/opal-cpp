# Out-of-tree consumer of opal_cpp: the quick-start acceptance test.
# CI builds this module standalone (cd examples/bazel-consumer && bazel test //...).
module(
    name = "opal_cpp_consumer",
    version = "0.0.0",
)

bazel_dep(name = "opal_cpp", version = "0.0.0")

# Until opal_cpp is published to the Bazel Central Registry (deferred until
# the project is production-validated), consume it by path or git override.
local_path_override(
    module_name = "opal_cpp",
    path = "../..",
)

bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.8.0")
