load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bazel:copts.bzl", "OPAL_COPTS")

# Hand-written prototype of the code the Phase 2/3/4 generators will emit for
# model/weather.smithy; its e2e test is the Phase 1 exit criterion.

cc_library(
    name = "weather_handwritten",
    srcs = [
        "handwritten/weather_client.cc",
        "handwritten/weather_server.cc",
        "handwritten/weather_types.cc",
    ],
    hdrs = [
        "handwritten/weather_client.h",
        "handwritten/weather_server.h",
        "handwritten/weather_types.h",
    ],
    copts = OPAL_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//runtime:client",
        "//runtime:core",
        "//runtime:http",
        "//runtime:json",
        "//runtime:server",
    ],
)

cc_test(
    name = "generated_types_test",
    size = "small",
    srcs = ["generated_types_test.cc"],
    copts = OPAL_COPTS,
    deps = [
        "//examples/weather/generated:types",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "generated_client_e2e_test",
    size = "small",
    srcs = ["generated_client_e2e_test.cc"],
    copts = OPAL_COPTS,
    tags = ["requires-network"],
    deps = [
        ":weather_handwritten",
        "//examples/weather/generated:client",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "generated_server_e2e_test",
    size = "small",
    srcs = ["generated_server_e2e_test.cc"],
    copts = OPAL_COPTS,
    deps = [
        ":weather_handwritten",
        "//examples/weather/generated:client",
        "//examples/weather/generated:server",
        "//runtime:client",
        "//runtime:http",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "weather_e2e_test",
    size = "small",
    srcs = ["handwritten/weather_e2e_test.cc"],
    copts = OPAL_COPTS,
    tags = ["requires-network"],
    deps = [
        ":weather_handwritten",
        "@googletest//:gtest_main",
    ],
)

# Same e2e suite with the production Beast transport as a third variant.
# Separate target so the Boost dependency stays out of the dep-light tests.
cc_test(
    name = "weather_e2e_beast_test",
    size = "small",
    srcs = ["handwritten/weather_e2e_test.cc"],
    copts = OPAL_COPTS,
    defines = ["OPAL_E2E_HAVE_BEAST"],
    tags = ["requires-network"],
    deps = [
        ":weather_handwritten",
        "//runtime:http_beast",
        "@googletest//:gtest_main",
    ],
)
